<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Unified circular mask for file previews. The same shape is used by grid and list thumbnails. -->
    <style name="AmazeModRoundedThumbnailShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Material Components dialogs: A17-like rounded surface and tonal/pill action buttons. -->
    <style name="AmazeModMaterialAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/AmazeModDialogShape</item>
        <item name="buttonBarButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="android:buttonBarButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AmazeModDialogActionButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AmazeModDialogActionButton</item>
    </style>

    <style name="AmazeModDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="AmazeModDialogActionButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:background">@drawable/amaze_mod_dialog_action_button</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
