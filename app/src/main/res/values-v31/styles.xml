<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="appCompatMonetLight" parent="appCompatLight">
        <item name="colorPrimary">@android:color/system_accent1_500</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_600</item>
        <item name="colorAccent">@android:color/system_accent1_600</item>
        <item name="colorSecondary">@android:color/system_accent1_600</item>
        <item name="colorControlActivated">@android:color/system_accent1_600</item>
        <item name="colorControlNormal">@android:color/system_neutral1_900</item>
        <item name="colorControlHighlight">@android:color/system_accent1_100</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="appCompatMonetDark" parent="appCompatDark">
        <!-- Runtime Amaze app bars still use MonetColorHelper's darker surface tone. Material
             controls/dialog focus states should use the lighter control tone instead. -->
        <item name="colorPrimary">@android:color/system_accent1_200</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_700</item>
        <item name="colorAccent">@android:color/system_accent1_200</item>
        <item name="colorSecondary">@android:color/system_accent1_200</item>
        <item name="colorControlActivated">@android:color/system_accent1_200</item>
        <item name="colorControlNormal">@android:color/system_neutral1_100</item>
        <item name="colorControlHighlight">@android:color/system_accent1_800</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="appCompatMonetBlack" parent="appCompatBlack">
        <item name="colorPrimary">@android:color/system_accent1_200</item>
        <item name="colorPrimaryDark">@android:color/system_accent1_700</item>
        <item name="colorAccent">@android:color/system_accent1_200</item>
        <item name="colorSecondary">@android:color/system_accent1_200</item>
        <item name="colorControlActivated">@android:color/system_accent1_200</item>
        <item name="colorControlNormal">@android:color/system_neutral1_100</item>
        <item name="colorControlHighlight">@android:color/system_accent1_800</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
